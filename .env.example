# Database Configuration
DATABASE_URL=postgresql://subscriptiq_user:dev_password@localhost:5432/subscriptiq_db

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=DEBUG

# Email Configuration (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Application Configuration
APP_NAME=SubscriptIQ
APP_VERSION=1.0.0

# Stripe/Payment Processing (optional, for Module 3)
STRIPE_API_KEY=sk_test_your_key

# Feature Flags
ENABLE_DEMO_DATA=True
ENABLE_AUDIT_LOGGING=True

# Module 3: Billing & Finance Configuration
# Scheduler - Set to 'true' on ONLY ONE instance in production
ENABLE_SCHEDULER=false
# Cron format: minute hour day month day_of_week
BILLING_CRON=0 0 * * *           # Run billing daily at midnight UTC
OVERDUE_CHECK_CRON=0 1 * * *     # Check overdue invoices daily at 1 AM UTC

